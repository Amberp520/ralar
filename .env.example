# RALAR CONFIGURATION & ENVIRONMENT VARIABLES
# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Pollar SDK & Server Credentials
# Publishable key for client SDK authentication (testnet)
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=pub_testnet_01jh9x82ralar001testnetkey

# Secret key for server-to-server operations (funding, secure settlement)
# CRITICAL: Backend / server only. NEVER expose to client bundle.
POLLAR_SECRET_KEY=sec_testnet_01jh9x82ralar002secretbackendkey

# Database Connection URL (PostgreSQL / Room local ledger)
DATABASE_URL=postgresql://ralar_user:ralar_pass@localhost:5432/ralar_db

# Stellar Settlement & Verification
# Primary: Stellar RPC endpoint
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Fallback: Horizon Testnet endpoint
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Stellar Testnet Block Explorer URL base for verified transactions
NEXT_PUBLIC_STELLAR_EXPLORER_BASE=https://stellar.expert/explorer/testnet/tx

# Authoritative Settlement Asset
# Testnet USDC or native XLM
NEXT_PUBLIC_ASSET_CODE=USDC

# Asset Issuer account (never hardcode in production)
# Example Stellar Testnet USDC Issuer:
NEXT_PUBLIC_ASSET_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Reconciliation Service Secret Bearer Token
RECONCILE_SECRET=rlr_sec_reconciliation_token_99x88q

